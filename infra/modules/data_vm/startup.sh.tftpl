#!/bin/bash
# Runs at every boot of the data VM (Container-Optimized OS, Docker built in).
# The database password is read from Secret Manager, never from code.
set -euo pipefail

META="http://metadata.google.internal/computeMetadata/v1"
TOKEN=$(curl -s -H "Metadata-Flavor: Google" "$META/instance/service-accounts/default/token" \
  | sed -n -E 's/.*"access_token": *"([^"]+)".*/\1/p')
DB_PASSWORD=$(curl -s -H "Authorization: Bearer $TOKEN" \
  "https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets/${db_password_secret_id}/versions/latest:access" \
  | sed -n -E 's/.*"data": *"([^"]+)".*/\1/p' | base64 -d)

docker network create devnet 2>/dev/null || true

start() {
  docker rm -f "$1" >/dev/null 2>&1 || true
  docker run -d --name "$@"
}

start postgres --restart=always --network devnet -p 5432:5432 \
  -v pgdata:/var/lib/postgresql/data \
  -e POSTGRES_DB=${db_name} -e POSTGRES_USER=${db_user} -e POSTGRES_PASSWORD="$DB_PASSWORD" \
  postgres:16-alpine

start rabbitmq --restart=always --network devnet -p 5672:5672 \
  -e RABBITMQ_DEFAULT_USER=${db_user} -e RABBITMQ_DEFAULT_PASS="$DB_PASSWORD" \
  rabbitmq:3-alpine

start redis --restart=always --network devnet -p 6379:6379 \
  redis:7-alpine redis-server --requirepass "$DB_PASSWORD"

# Placeholder until the twin worker (SMPL-X, DT-06 and DT-09) is built.
start twin-worker --restart=always --network devnet \
  python:3.12-alpine python -c "import time; print('twin worker placeholder: waiting for jobs', flush=True); time.sleep(10**9)"
